<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Excel library -->
    <PackageReference Include="ClosedXML" Version="0.105.*" />
    <!-- Template/report engine built on top of ClosedXML -->
    <PackageReference Include="ClosedXML.Report" Version="0.2.*" />
    <!-- Lightweight embedded database - no server required -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>

</Project>
